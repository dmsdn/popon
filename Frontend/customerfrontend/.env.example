# 이 파일을 .env.local 로 복사해서 값만 바꿔 쓰세요. (.env.local은 커밋되지 않습니다)

# ── 필수 ──────────────────────────────────────────────
# 네이버 지도 SDK Client ID. /map 화면에 필요하며, 없으면 지도 대신 안내 문구만 뜹니다.
# 값은 백엔드 application.yml의 naver.maps.client-id와 같습니다 (팀에 문의).
# 브라우저에 노출되는 공개 키이고, NCP 「Web 서비스 URL」 화이트리스트에
# http://localhost:5173 이 등록돼 있어야 동작합니다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# ── 선택 ──────────────────────────────────────────────
# API 호출의 앞부분. 비워두면 상대경로(/api/...)로 나가 dev 서버 rewrites를 탑니다 — 평소엔 비워 두세요.
# NEXT_PUBLIC_API_BASE_URL=

# dev 서버가 /api, /uploads 를 rewrite할 백엔드 주소. 서버 전용이라 브라우저에 노출되지 않습니다.
# 비워두면 http://localhost:8080 (내 로컬 백엔드)을 씁니다.
# BACKEND_ORIGIN=http://3.35.218.209:8080

# 카카오/구글 로그인 버튼이 전체 페이지 이동으로 쓰는 절대주소 (브라우저 번들에 노출).
# 구글은 리디렉션 URI에 IP를 안 받아서 nip.io(IP→도메인 매핑)를 씁니다.
# 카카오·구글 콘솔에 등록한 Redirect URI의 origin과 반드시 일치해야 합니다.
# 로컬 백엔드로 테스트할 때는 비워 두면 http://localhost:8080 이 쓰입니다.
# NEXT_PUBLIC_OAUTH_BASE=http://3.35.218.209.nip.io:8080
