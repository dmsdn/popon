# 소비자 웹 (Next.js) 환경변수 예시
# 사용법: 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 커밋하지 않습니다)
# 값을 바꾼 뒤에는 개발 서버를 다시 시작해야 반영됩니다.

# ── 필수 ──────────────────────────────────────────────
# 네이버 지도 Client ID — /map 화면에 필요. 없으면 지도 대신 안내 문구만 표시
# NCP 콘솔 > Maps > Application 의 "Web 서비스 URL"에 http://localhost:5173 을 등록해야 동작
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# ── 선택 (비워두면 로컬 기본값 사용) ───────────────────
# dev 서버가 /api, /uploads 를 프록시할 백엔드 주소 (서버 전용, 브라우저에 노출 안 됨)
# 기본값: http://localhost:8080
BACKEND_ORIGIN=

# 카카오 · 구글 로그인 버튼이 이동할 백엔드 주소
# 소셜 로그인 콘솔에 등록한 Redirect URI 의 주소와 같아야 함
# 기본값: http://localhost:8080
NEXT_PUBLIC_OAUTH_BASE=

# API 요청 주소 앞부분. 평소엔 비워두면 상대경로(/api/...)로 요청하고 위 프록시를 탑니다
NEXT_PUBLIC_API_BASE_URL=
