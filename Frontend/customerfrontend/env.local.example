# .env.local.example
#
# 이 프로젝트를 로컬에서 실행하려면 프로젝트 루트(package.json이 있는 위치, 즉
# Frontend/customerfrontend/ 바로 아래)에 ".env.local" 이라는 파일을 새로 만들고,
# 아래 내용을 복사해서 실제 값으로 채워 넣으면 됩니다.
#
# ⚠️ .env.local은 절대 git에 커밋하지 마세요 (보통 .gitignore에 이미 포함되어 있어요).
#    이 예시 파일(.env.local.example)만 커밋해서 팀원들이 어떤 값이 필요한지 알 수 있게
#    하는 용도예요.
#
# 값을 바꾼 뒤에는 반드시 개발 서버를 재시작해야 반영돼요 (npm run dev 다시 실행).


# ============================================================
# 1. 백엔드 API 주소
# ============================================================
# 프론트가 실제 백엔드 서버로 요청을 보낼 때 쓰는 기본 주소예요.
#
# - 비워두면(값을 아예 안 넣으면) 빈 문자열로 처리되고, 상대경로("/api/...")로
#   요청이 나가요. 이 경우 Next.js 프록시/리버스프록시 설정이 따로 있어야 백엔드로
#   전달돼요.
# - 로컬에서 백엔드를 같이 띄워서 테스트한다면, 백엔드가 떠 있는 주소를 직접
#   적어주는 게 제일 확실해요. (Spring Boot 기본 포트는 보통 8080)
#
# 예시:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 실제 배포된 백엔드 서버를 쓰고 싶으면 그 주소로 바꾸세요:
# NEXT_PUBLIC_API_BASE_URL=https://api.실제도메인.com


# ============================================================
# 2. 네이버 지도 API 키 (/map 페이지에서 사용)
# ============================================================
# 팝업 위치를 지도에 핀으로 보여주는 /map 페이지에서 필요해요. 이게 없으면
# /map 페이지에서 "지도를 표시할 수 없어요" 안내만 뜨고, 나머지 화면은 정상 작동해요
# (필수 아님, 지도 기능만 안 뜨는 것뿐).
#
# 발급 방법:
#   1. NAVER Cloud Platform 콘솔(console.ncloud.com) 로그인
#      - 결제수단(카드)을 한 번은 등록해야 콘솔 이용이 가능해요 (무료 쿼터 내여도 필요)
#      - 백엔드 담당자가 지오코딩(주소→좌표 변환)용으로 이미 계정을 만들어뒀을 수
#        있으니, 새로 안 만들고 그 계정을 같이 쓰는 것도 방법이에요
#   2. Products & Services > AI·Application Service > Maps 이동
#   3. 기존 Application이 있으면 재사용, 없으면 새로 만들기
#   4. Application 수정 화면에서 "Web Dynamic Map" 체크 (지오코딩만 켜져있으면
#      지도가 안 뜨니 꼭 이것도 체크해야 해요)
#   5. "서비스 URL" 등록 — 이거 안 하면 지도가 아예 안 떠요
#        로컬: http://localhost:3000
#        실제 배포 주소도 별도로 등록
#   6. Client ID 복사해서 아래에 붙여넣기
#      (Client Secret은 백엔드 전용이에요 - 프론트엔 필요 없어요, 절대 여기 넣지 마세요)
#
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=여기에_발급받은_Client_ID_붙여넣기


# ============================================================
# 참고: NEXT_PUBLIC_ 접두사가 붙은 이유
# ============================================================
# Next.js에서 브라우저(클라이언트) 쪽 코드에서 읽어야 하는 환경변수는
# 반드시 이름 앞에 "NEXT_PUBLIC_"을 붙여야 해요. 이게 없으면 서버에서만
# 읽히고 브라우저 화면에는 undefined로 나와요. 위 두 값은 둘 다 브라우저에서
# 직접 써야 해서 이 접두사가 붙어있어요 - 새 환경변수를 추가할 때도 이 규칙을
# 따라야 해요.
