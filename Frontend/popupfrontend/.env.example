# 주최자 센터 (Vite) 환경변수 예시
# 사용법: 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 커밋하지 않습니다)

# ── 필수 ──────────────────────────────────────────────
# 네이버 지도 Client ID — 팝업 등록 폼의 주소 검색 · 지도 미리보기에 필요
# NCP 콘솔 > Maps > Application 의 "Web 서비스 URL"에 http://localhost:5174 를 등록해야 동작
VITE_NAVER_MAP_CLIENT_ID=

# ── 선택 (비워두면 로컬 기본값 사용) ───────────────────
# dev 서버가 /api, /uploads 를 프록시할 백엔드 주소
# 기본값: http://localhost:8080
VITE_API_TARGET=

# ── 배포 빌드 전용 ────────────────────────────────────
# 다른 앱으로 나가는 링크 주소. Vite 환경변수는 빌드할 때 코드에 고정되므로
# 배포용으로 빌드할 때는 반드시 실제 주소를 넣어야 합니다. (안 넣으면 localhost 링크가 됨)
# 기본값: 소비자 앱 http://localhost:5173 / 관리자 콘솔 http://localhost:5175
VITE_CONSUMER_URL=
VITE_ADMIN_URL=
