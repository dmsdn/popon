# 현장 체크인 (Next.js) 환경변수 예시
# 사용법: 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 커밋하지 않습니다)
#
# 로컬 개발에서는 아무것도 설정하지 않아도 됩니다.
# /api 요청은 next.config.ts 의 rewrites 가 http://localhost:8080 으로 프록시합니다.

# ── 선택 ──────────────────────────────────────────────
# 현장 QR이 연결할 소비자 앱 주소
# 비워두면 현재 접속 주소에서 자동으로 계산합니다
#   로컬: localhost:5176 → localhost:5173
#   배포: checkin.<도메인> → <도메인>
NEXT_PUBLIC_CONSUMER_URL=
